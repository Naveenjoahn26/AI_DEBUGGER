# AI Debugger Configuration

# Groq API Configuration (Required for AI Reasoning Agent)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# HuggingFace API Token (Optional: for cloud embeddings. If omitted, built-in fallback embeddings are used)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage & Database
DATABASE_URL=sqlite:///./backend/test.db
CHROMA_DIR=./chroma_db

